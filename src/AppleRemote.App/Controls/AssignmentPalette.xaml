<UserControl x:Class="AppleRemote.App.Controls.AssignmentPalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:AppleRemote.App"
             MinWidth="0">
    <Border Padding="16" CornerRadius="12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="{l:T Assign.Title}" FontWeight="SemiBold"
                       FontSize="19" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4" />
            <TextBlock Text="{l:T Assign.Help}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
            <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="7"
                    Padding="12,10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{l:T Assign.Selected}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" />
                    <TextBlock Text="{Binding SelectedAssignmentLabel}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" Margin="0,2,0,4"/>
                    <TextBlock Text="{Binding SelectedAssignmentValue}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <WrapPanel Margin="0,0,0,12">
                <Button Content="{l:T Assign.Record}" Command="{Binding RecordSelectedAssignmentCommand}"
                        Margin="0,0,6,6" Padding="12,7" />
                <Button Content="{l:T Assign.Clear}" Command="{Binding ClearSelectedAssignmentCommand}"
                        Margin="0,0,6,6" Padding="12,7" />
                <Button Content="{l:T Assign.Default}" Command="{Binding ResetSelectedAssignmentCommand}"
                        Margin="0,0,0,6" Padding="12,7" />
            </WrapPanel>
            <ListBox ItemsSource="{Binding AssignmentCategories}"
                     SelectedValuePath="Code" SelectedValue="{Binding SelectedAssignmentCategory, Mode=TwoWay}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Name}" FontSize="12" /></DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,4,4"/>
                        <Setter Property="Padding" Value="7,5"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <TextBlock Text="{l:T Assign.Search}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,5"/>
            <TextBox Text="{Binding AssignmentSearch, UpdateSourceTrigger=PropertyChanged}"
                     Padding="10,8" Margin="0,0,0,8" />
            <ScrollViewer MaxHeight="255" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="CommandItems" ItemsSource="{Binding FilteredAssignmentOptions}"
                              PreviewMouseLeftButtonDown="CommandItems_MouseDown"
                              PreviewMouseMove="CommandItems_MouseMove">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.AssignSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" HorizontalContentAlignment="Left"
                                    Content="{Binding Title}" ToolTip="{l:T Assign.DragHint}"
                                    Padding="10,7" Margin="0,0,4,3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Border>
</UserControl>
