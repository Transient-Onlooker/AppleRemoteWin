<UserControl x:Class="AppleRemote.App.Views.A2854RemoteDrawing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <!-- Original vector illustration of the third-generation A2854.
         Distinct from the first-generation RemoteDrawing and its calibration. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Measured against the provided front-facing A2854 photograph:
                 soft vertical aluminum lighting and matte, not shiny, black.
                 Gradients mimic diffuse ambient light, not hard specular glare. -->
            <RadialGradientBrush x:Key="A2854BlackRubber"
                                 Center="0.47,0.45" GradientOrigin="0.47,0.42"
                                 RadiusX="0.72" RadiusY="0.76">
                <GradientStop Color="#29292B" Offset="0" />
                <GradientStop Color="#222224" Offset="0.58" />
                <GradientStop Color="#161719" Offset="1" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="A2854RingRubber"
                                 Center="0.52,0.48" GradientOrigin="0.49,0.45"
                                 RadiusX="0.74" RadiusY="0.74">
                <GradientStop Color="#323234" Offset="0" />
                <GradientStop Color="#252527" Offset="0.5" />
                <GradientStop Color="#151516" Offset="1" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="A2854CenterRubber"
                                 Center="0.48,0.40" GradientOrigin="0.46,0.38"
                                 RadiusX="0.73" RadiusY="0.76">
                <GradientStop Color="#303032" Offset="0" />
                <GradientStop Color="#272729" Offset="0.55" />
                <GradientStop Color="#1B1B1D" Offset="1" />
            </RadialGradientBrush>
            <SolidColorBrush x:Key="A2854ActiveBrush" Color="#404044" />
            <SolidColorBrush x:Key="A2854VolumePressed" Color="#3B3B3D" />
            <LinearGradientBrush x:Key="A2854SilverPower" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F5F6F7" Offset="0" />
                <GradientStop Color="#DFE2E5" Offset="0.75" />
                <GradientStop Color="#CACED3" Offset="1" />
            </LinearGradientBrush>
            <Style x:Key="A2854Button" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource A2854BlackRubber}" />
                <Setter Property="BorderBrush" Value="#515255" />
                <Setter Property="BorderThickness" Value="1.4" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                        <Setter Property="Background" Value="{StaticResource A2854ActiveBrush}" />
                        <Setter Property="BorderBrush" Value="#9099A2" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="A2854PowerKey" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource A2854SilverPower}" />
                <Setter Property="BorderBrush" Value="#6F757B" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                        <Setter Property="Background" Value="#CED5DB" />
                        <Setter Property="BorderBrush" Value="#535A64" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="A2854RingKey" TargetType="Border">
                <Setter Property="Background" Value="#F1F2F3" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                        <Setter Property="Background" Value="#FFFFFF" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="A2854VolumeHalf" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                        <Setter Property="Background" Value="{StaticResource A2854VolumePressed}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="A2854Glyph" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Symbol" />
                <Setter Property="Foreground" Value="#F0F0F0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="46" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Width="360" Height="1410" CornerRadius="67"
            BorderBrush="#ADB0B3" BorderThickness="1.8">
        <Border.Background>
            <LinearGradientBrush StartPoint="0.15,0" EndPoint="0.65,1">
                <GradientStop Color="#EFF0F2" Offset="0" />
                <GradientStop Color="#E0E2E4" Offset="0.17" />
                <GradientStop Color="#C8CACD" Offset="0.49" />
                <GradientStop Color="#ABADB0" Offset="0.78" />
                <GradientStop Color="#9C9EA1" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Canvas>
            <!-- Top microphone grille and power button. No microphone data is read. -->
            <Rectangle Canvas.Left="170" Canvas.Top="66" Width="20" Height="5"
                       RadiusX="2.5" RadiusY="2.5" Fill="#353638" />
            <Rectangle Canvas.Left="172" Canvas.Top="67" Width="16" Height="1"
                       Fill="#171819" Opacity="0.48" />
            <Border Canvas.Left="259" Canvas.Top="39" Width="62" Height="62" CornerRadius="31"
                    Tag="{Binding PowerPressed}" Style="{StaticResource A2854PowerKey}"
                    ToolTip="Power">
                <TextBlock Text="⏻" FontFamily="Segoe UI Symbol" FontSize="36"
                           Foreground="#212427" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <!-- The photograph has one continuous black direction disc,
                 one inset center circle, and four tiny white location dots.
                 There is no extra concentric ring. -->
            <Ellipse Canvas.Left="17" Canvas.Top="131" Width="326" Height="326"
                     Fill="{StaticResource A2854RingRubber}"
                     Stroke="#343538" StrokeThickness="1.5" />
            <Border Canvas.Left="89" Canvas.Top="203" Width="182" Height="182"
                    CornerRadius="91" BorderBrush="#101113" BorderThickness="1.6"
                    Tag="{Binding TouchPressed}" ToolTip="Clickpad center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource A2854CenterRubber}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter Property="Background" Value="{StaticResource A2854ActiveBrush}" />
                                <Setter Property="BorderBrush" Value="#626568" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <!-- Direction indicators follow actual A2854 0xFB button bits. -->
            <Border Canvas.Left="176" Canvas.Top="146" Width="8" Height="8" CornerRadius="4"
                    Tag="{Binding UpPressed}" Style="{StaticResource A2854RingKey}" ToolTip="Up"/>
            <Border Canvas.Left="176" Canvas.Top="434" Width="8" Height="8" CornerRadius="4"
                    Tag="{Binding DownPressed}" Style="{StaticResource A2854RingKey}" ToolTip="Down"/>
            <Border Canvas.Left="32" Canvas.Top="290" Width="8" Height="8" CornerRadius="4"
                    Tag="{Binding LeftPressed}" Style="{StaticResource A2854RingKey}" ToolTip="Left"/>
            <Border Canvas.Left="320" Canvas.Top="290" Width="8" Height="8" CornerRadius="4"
                    Tag="{Binding RightPressed}" Style="{StaticResource A2854RingKey}" ToolTip="Right"/>

            <!-- Live 0xFC touch contacts drawn over the 360-square ring.
                 Projection clips each dot inside the round physical surface. -->
            <Grid Canvas.Left="0" Canvas.Top="114" Width="360" Height="360"
                  ClipToBounds="True">
                <Grid.Clip>
                    <EllipseGeometry Center="180,180" RadiusX="163" RadiusY="163" />
                </Grid.Clip>
                <Canvas>
                    <Polyline Points="{Binding A2854TrailOnePoints}" Stroke="#CEDFEA"
                              StrokeThickness="2.6" StrokeLineJoin="Round"
                              Opacity="{Binding A2854TrailOneOpacity}" />
                    <Polyline Points="{Binding A2854TrailTwoPoints}" Stroke="#E5C9B5"
                              StrokeThickness="2.6" StrokeLineJoin="Round"
                              Opacity="{Binding A2854TrailTwoOpacity}" />
                </Canvas>
                <ItemsControl ItemsSource="{Binding Fingers}" IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                            <Setter Property="Visibility"
                                    Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="30" Height="30" CornerRadius="15"
                                    BorderBrush="#FFFFFF" BorderThickness="2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#C9DCE9" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Index}" Value="1">
                                                <Setter Property="Background" Value="#E7C5A9" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#23262A" FontSize="13" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Index}" Value="1">
                                                    <Setter Property="Text" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Right-side Siri key is drawn as a slim side switch. -->
            <Border Canvas.Left="354" Canvas.Top="178" Width="9" Height="190"
                    CornerRadius="4" Tag="{Binding SiriPressed}"
                    Style="{StaticResource A2854PowerKey}" ToolTip="Siri (side)"/>

            <!-- Back / TV -->
            <Border Canvas.Left="36" Canvas.Top="470" Width="128" Height="128"
                    CornerRadius="64" Tag="{Binding MenuPressed}"
                    Style="{StaticResource A2854Button}" ToolTip="Back">
                <Canvas Width="55" Height="56" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M 34,9 L 15,28 L 34,47"
                          Stroke="#EDEFF1" StrokeThickness="4.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Canvas>
            </Border>
            <Border Canvas.Left="194" Canvas.Top="470" Width="128" Height="128"
                    CornerRadius="64" Tag="{Binding TvPressed}"
                    Style="{StaticResource A2854Button}" ToolTip="TV / Home">
                <Canvas Width="54" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M 8,9 L 46,9 L 46,35 L 8,35 Z M 19,45 L 35,45"
                          Stroke="#EDEFF1" StrokeThickness="3.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Canvas>
            </Border>

            <!-- Play/Pause and Mute on the left, two-part volume pill on the right. -->
            <Border Canvas.Left="36" Canvas.Top="624" Width="128" Height="128"
                    CornerRadius="64" Tag="{Binding PlayPressed}"
                    Style="{StaticResource A2854Button}" ToolTip="Play / Pause">
                <!-- Match the smaller compact play/pause mark in the photo: keep
                     the entire glyph centered without oversized tall bars. -->
                <Canvas Width="46" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M 4,10 L 4,36 L 24,23 Z"
                          Stroke="#F0F0F0" Fill="Transparent" StrokeThickness="2.8"
                          StrokeLineJoin="Round" />
                    <Rectangle Canvas.Left="31" Canvas.Top="11" Width="3" Height="24"
                               Fill="#F0F0F0" RadiusX="0.7" />
                    <Rectangle Canvas.Left="39" Canvas.Top="11" Width="3" Height="24"
                               Fill="#F0F0F0" RadiusX="0.7" />
                </Canvas>
            </Border>
            <Border Canvas.Left="36" Canvas.Top="778" Width="128" Height="128"
                    CornerRadius="64" Tag="{Binding MutePressed}"
                    Style="{StaticResource A2854Button}" ToolTip="Mute">
                <!-- Speaker and diagonal slash must overlap as on the physical
                     mute key, rather than a separate slash to its right. -->
                <Grid Width="54" Height="54" HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Path Data="M 8,23 L 18,23 L 29,14 L 29,40 L 18,31 L 8,31 Z"
                          Stroke="#F0F0F0" StrokeThickness="2.8"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" Fill="Transparent" />
                    <Path Data="M 12,10 L 43,44" Stroke="#F0F0F0"
                          StrokeThickness="3.0" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Grid>
            </Border>

            <Grid Canvas.Left="194" Canvas.Top="624" Width="128" Height="282">
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <Border Grid.RowSpan="2" CornerRadius="64"
                        Background="{StaticResource A2854BlackRubber}"
                        BorderBrush="#4D4E50" BorderThickness="1.4" />
                <Border Grid.Row="0" CornerRadius="64,64,0,0"
                        Tag="{Binding VolUpPressed}" Style="{StaticResource A2854VolumeHalf}"
                        ToolTip="Volume up">
                    <TextBlock Text="+" Style="{StaticResource A2854Glyph}" FontFamily="Segoe UI" FontWeight="Light" FontSize="58" />
                </Border>
                <Border Grid.Row="1" CornerRadius="0,0,64,64"
                        Tag="{Binding VolDownPressed}" Style="{StaticResource A2854VolumeHalf}"
                        ToolTip="Volume down">
                    <TextBlock Text="−" Style="{StaticResource A2854Glyph}" FontFamily="Segoe UI" FontWeight="Light" FontSize="56" />
                </Border>
            </Grid>

            <!-- The photographed lower aluminum face is intentionally blank.
                 Battery is UI metadata and belongs in the status card,
                 not printed on the rendered hardware. -->
        </Canvas>
    </Border>
</UserControl>
