<Page xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:l="clr-namespace:AppleRemote.App" xmlns:c="clr-namespace:AppleRemote.App.Controls" x:Class="AppleRemote.App.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:AppleRemote.App.Views"
      ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Branch" TargetType="Rectangle">
                <Setter Property="Fill" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="BranchStem" TargetType="Rectangle" BasedOn="{StaticResource Branch}">
                <Style.Triggers><DataTrigger Binding="{Binding AnyOn}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </DataTrigger></Style.Triggers>
            </Style>
            <Style x:Key="BranchWinUsb" TargetType="Rectangle" BasedOn="{StaticResource Branch}">
                <Style.Triggers><DataTrigger Binding="{Binding WinUsbOn}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </DataTrigger></Style.Triggers>
            </Style>
            <Style x:Key="BranchFilter" TargetType="Rectangle" BasedOn="{StaticResource Branch}">
                <Style.Triggers><DataTrigger Binding="{Binding FilterOn}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </DataTrigger></Style.Triggers>
            </Style>
            <Style x:Key="BranchDongle" TargetType="Rectangle" BasedOn="{StaticResource Branch}">
                <Style.Triggers><DataTrigger Binding="{Binding DongleOn}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </DataTrigger></Style.Triggers>
            </Style>
            <Style x:Key="Pointer" TargetType="Line">
                <Setter Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
            </Style>
            <Style x:Key="A2854MappingCaption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="1,0,0,4" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <!-- At narrow widths move the mapping diagram above settings rather than
         leaving the right pane clipped off-screen. The outer viewer scrolls
         vertically; horizontal scroll is a fallback for tiny windows. -->
    <ScrollViewer x:Name="SettingsViewport" Grid.Row="0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
    <Grid x:Name="ResponsiveSettingsGrid" Margin="18,6,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="RemoteMappingPanel" Grid.Column="0" Margin="0,0,32,0">
        <TextBlock Text="{l:T Settings.RemoteKeys}" Style="{StaticResource Section}" />
        <!-- Gen-1 mapping diagram stays identical, shown only for gen-1. -->
        <Grid Width="690" Height="500" HorizontalAlignment="Center" Margin="0,0,0,14">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding A2854Mode}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <!-- Nothing under Play/Volume: the remote is cut off there -->
            <Grid Width="190" Height="440" Margin="250,50,250,0" VerticalAlignment="Top" ClipToBounds="True">
                <Viewbox Width="190" Height="600" VerticalAlignment="Top" Stretch="Uniform">
                    <local:RemoteDrawing DataContext="{Binding Remote}" IsEnabled="False" />
                </Viewbox>
            </Grid>
            <Canvas>
            <c:KeyPicker Canvas.Left="270" Canvas.Top="0" Width="150" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}" Macros="{Binding MacroChoices}" Key="{Binding Bindings[up].Key}" />
            <c:KeyPicker Canvas.Left="92" Canvas.Top="94" Width="150" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}" Macros="{Binding MacroChoices}" Key="{Binding Bindings[left].Key}" />
            <c:KeyPicker Canvas.Left="270" Canvas.Top="94" Width="150" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}" Macros="{Binding MacroChoices}" Key="{Binding Bindings[click].Key}" />
            <Line X1="242" Y1="268" X2="272" Y2="268" Style="{StaticResource Pointer}" />
            <c:KeyPicker Canvas.Left="92" Canvas.Top="252" Width="150" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}" Macros="{Binding MacroChoices}" Key="{Binding Bindings[menu].Key}" />
            <Line X1="242" Y1="348" X2="273" Y2="348" Style="{StaticResource Pointer}" />
            <c:KeyPicker Canvas.Left="92" Canvas.Top="332" Width="150" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}" Macros="{Binding MacroChoices}" Key="{Binding Bindings[siri].Key}" />
            <Line X1="242" Y1="428" X2="273" Y2="428" Style="{StaticResource Pointer}" />
            <c:KeyPicker Canvas.Left="92" Canvas.Top="412" Width="150" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}" Macros="{Binding MacroChoices}" Key="{Binding Bindings[playpause].Key}" />
            <c:KeyPicker Canvas.Left="270" Canvas.Top="174" Width="150" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}" Macros="{Binding MacroChoices}" Key="{Binding Bindings[down].Key}" />
            <c:KeyPicker Canvas.Left="448" Canvas.Top="94" Width="150" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}" Macros="{Binding MacroChoices}" Key="{Binding Bindings[right].Key}" />
            <Line X1="448" Y1="268" X2="415" Y2="268" Style="{StaticResource Pointer}" />
            <c:KeyPicker Canvas.Left="448" Canvas.Top="252" Width="150" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}" Macros="{Binding MacroChoices}" Key="{Binding Bindings[tv].Key}" />
            <Line X1="448" Y1="352" X2="418" Y2="352" Style="{StaticResource Pointer}" />
            <c:KeyPicker Canvas.Left="448" Canvas.Top="336" Width="150" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}" Macros="{Binding MacroChoices}" Key="{Binding Bindings[volup].Key}" />
            <Line X1="448" Y1="423" X2="418" Y2="423" Style="{StaticResource Pointer}" />
            <c:KeyPicker Canvas.Left="448" Canvas.Top="407" Width="150" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}" Macros="{Binding MacroChoices}" Key="{Binding Bindings[voldown].Key}" />
            </Canvas>
        </Grid>

        <!-- Dedicated USB-C A2854 layout with physical button positions and
             an editable mute action. Only safely dispatchable inputs get
             pickers: TV, Siri and Power are intentionally blocked in
             RemoteSession even when keyboard bindings are enabled. -->
        <Grid Width="690" Height="615" HorizontalAlignment="Center" Margin="0,0,0,14"
              Visibility="{Binding A2854Mode, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="565" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Width="158" Height="565" VerticalAlignment="Top"
                  HorizontalAlignment="Center">
                <Viewbox Width="154" Height="565" Stretch="Uniform" VerticalAlignment="Top">
                    <local:A2854RemoteDrawing DataContext="{Binding Remote}" IsEnabled="False" />
                </Viewbox>
            </Grid>
            <Canvas Grid.Row="0">
                <StackPanel Canvas.Left="15" Canvas.Top="14" Width="188">
                    <TextBlock Text="{l:T A2854.Mapping.Up}" Style="{StaticResource A2854MappingCaption}" />
                    <c:KeyPicker Width="180" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}"
                                 Macros="{Binding MacroChoices}" Key="{Binding Bindings[up].Key}" />
                </StackPanel>
                <StackPanel Canvas.Left="15" Canvas.Top="111" Width="188">
                    <TextBlock Text="{l:T A2854.Mapping.Left}" Style="{StaticResource A2854MappingCaption}" />
                    <c:KeyPicker Width="180" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}"
                                 Macros="{Binding MacroChoices}" Key="{Binding Bindings[left].Key}" />
                </StackPanel>
                <StackPanel Canvas.Left="15" Canvas.Top="208" Width="188">
                    <TextBlock Text="{l:T A2854.Mapping.Back}" Style="{StaticResource A2854MappingCaption}" />
                    <c:KeyPicker Width="180" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}"
                                 Macros="{Binding MacroChoices}" Key="{Binding Bindings[menu].Key}" />
                </StackPanel>
                <StackPanel Canvas.Left="15" Canvas.Top="305" Width="188">
                    <TextBlock Text="{l:T A2854.Mapping.PlayPause}" Style="{StaticResource A2854MappingCaption}" />
                    <c:KeyPicker Width="180" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}"
                                 Macros="{Binding MacroChoices}" Key="{Binding Bindings[playpause].Key}" />
                </StackPanel>
                <StackPanel Canvas.Left="15" Canvas.Top="402" Width="188">
                    <TextBlock Text="{l:T A2854.Mapping.Mute}" Style="{StaticResource A2854MappingCaption}" />
                    <c:KeyPicker Width="180" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}"
                                 Macros="{Binding MacroChoices}" Key="{Binding Bindings[mute].Key}" />
                </StackPanel>
                <StackPanel Canvas.Left="488" Canvas.Top="14" Width="188">
                    <TextBlock Text="{l:T A2854.Mapping.Right}" Style="{StaticResource A2854MappingCaption}" />
                    <c:KeyPicker Width="180" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}"
                                 Macros="{Binding MacroChoices}" Key="{Binding Bindings[right].Key}" />
                </StackPanel>
                <StackPanel Canvas.Left="488" Canvas.Top="111" Width="188">
                    <TextBlock Text="{l:T A2854.Mapping.Center}" Style="{StaticResource A2854MappingCaption}" />
                    <c:KeyPicker Width="180" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}"
                                 Macros="{Binding MacroChoices}" Key="{Binding Bindings[click].Key}" />
                </StackPanel>
                <StackPanel Canvas.Left="488" Canvas.Top="208" Width="188">
                    <TextBlock Text="{l:T A2854.Mapping.Down}" Style="{StaticResource A2854MappingCaption}" />
                    <c:KeyPicker Width="180" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}"
                                 Macros="{Binding MacroChoices}" Key="{Binding Bindings[down].Key}" />
                </StackPanel>
                <StackPanel Canvas.Left="488" Canvas.Top="305" Width="188">
                    <TextBlock Text="{l:T A2854.Mapping.VolUp}" Style="{StaticResource A2854MappingCaption}" />
                    <c:KeyPicker Width="180" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}"
                                 Macros="{Binding MacroChoices}" Key="{Binding Bindings[volup].Key}" />
                </StackPanel>
                <StackPanel Canvas.Left="488" Canvas.Top="402" Width="188">
                    <TextBlock Text="{l:T A2854.Mapping.VolDown}" Style="{StaticResource A2854MappingCaption}" />
                    <c:KeyPicker Width="180" Choices="{Binding KeyChoices}" Software="{Binding SoftwareChoices}"
                                 Macros="{Binding MacroChoices}" Key="{Binding Bindings[voldown].Key}" />
                </StackPanel>
            </Canvas>
            <TextBlock Grid.Row="1" HorizontalAlignment="Center" TextAlignment="Center"
                       Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                       Text="{l:T A2854.Mapping.DisplayOnly}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>
        </StackPanel>
        <!-- Only SettingsViewport owns scrolling; a nested disabled viewer
             can consume mouse-wheel input over the settings controls. -->
        <Grid x:Name="RightSettingsPanel" Grid.Column="1">
        <StackPanel MinWidth="340" Margin="0,0,6,0"
                    TextElement.Foreground="#ECF1F7">
        <StackPanel.Resources>
            <Style TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource Section}">
                <Setter Property="Margin" Value="1,16,0,10" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#F3F5F8" />
            </Style>
            <!-- Fixed dark theme: explicit high-contrast colors rather than
                 inherited/default black text on charcoal card surfaces. -->
            <Style x:Key="A2854CardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#F4F6F9" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="LineHeight" Value="23" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            </Style>
            <Style x:Key="A2854Description" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="Foreground" Value="#E1E6ED" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="LineHeight" Value="22" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                <Setter Property="Margin" Value="0,7,0,0" />
            </Style>
            <Style x:Key="A2854Secondary" TargetType="TextBlock"
                   BasedOn="{StaticResource A2854Description}">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="#CBD3DC" />
                <Setter Property="LineHeight" Value="20" />
            </Style>
            <Style x:Key="A2854Status" TargetType="TextBlock"
                   BasedOn="{StaticResource A2854Description}">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#EAF2FC" />
            </Style>
        </StackPanel.Resources>

        <!-- Put device mode controls first: the active A2854 profile should not
             be buried below updates, language and generic settings. Plain cards
             avoid a giant empty CardControl content presenter on narrow windows. -->
        <TextBlock Text="{l:T A2854.Settings.Title}" Style="{StaticResource Head}" Margin="1,2,0,8" />
        <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="{l:T A2854.Settings.Adapter}" Style="{StaticResource A2854CardTitle}" />
                <ui:ToggleSwitch IsChecked="{Binding A2854Mode, Mode=TwoWay}"
                                 IsEnabled="{Binding CanChangeAdapter}"
                                 Margin="0,11,0,4" />
                <TextBlock Text="{l:T A2854.Settings.SwitchHint}" Style="{StaticResource A2854Description}" />
                <TextBlock Text="{l:T A2854.Settings.LegacyHint}" Style="{StaticResource A2854Secondary}" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{l:T A2854.Settings.PointerTitle}" Style="{StaticResource A2854CardTitle}" />
                <ui:ToggleSwitch IsChecked="{Binding A2854PointerEnabled, Mode=TwoWay}"
                                 Margin="0,11,0,4"/>
                <TextBlock Text="{l:T A2854.Settings.PointerHint}" Style="{StaticResource A2854Description}" />
                <CheckBox Content="{l:T A2854.Settings.UseMeasuredAxes}"
                          IsChecked="{Binding A2854PointerUseCalibration, Mode=TwoWay}"
                          Margin="0,12,0,2" />
                <TextBlock Text="{l:T A2854.Settings.AxesHint}" Style="{StaticResource A2854Secondary}" />
                <TextBlock Text="{l:T A2854.Settings.Sensitivity}" Style="{StaticResource A2854Status}"
                           Margin="0,12,0,6" />
                <Slider Minimum="0.02" Maximum="3.0" TickFrequency="0.05"
                        IsSnapToTickEnabled="False"
                        Value="{Binding A2854PointerSensitivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Border>

        <!-- Coordinate calibration is a deliberate manual measurement of
             physical finger-center reference points, separate from the LTK
             bond and from the actual Windows pointer mapper. -->
        <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,12"
                Visibility="{Binding A2854Mode, Converter={StaticResource BoolToVisibility}}">
            <StackPanel DataContext="{Binding Remote}">
                <TextBlock Text="{l:T A2854.Cal.Title}" Style="{StaticResource A2854CardTitle}" />
                <TextBlock Text="{l:T A2854.Cal.Instructions}" Style="{StaticResource A2854Description}"
                           Margin="0,8,0,12" />
                <TextBlock Text="{Binding LiveTouchCoordinates}" FontFamily="Consolas"
                           Style="{StaticResource A2854Status}" Margin="0,0,0,10" />
                <ComboBox ItemsSource="{Binding CalibrationTargetChoices}"
                          DisplayMemberPath="Name" SelectedValuePath="Code"
                          SelectedValue="{Binding SelectedCalibrationTarget, Mode=TwoWay}"
                          Margin="0,0,0,8" />
                <WrapPanel>
                    <ui:Button Content="{l:T A2854.Cal.Capture}" Command="{Binding CaptureCalibrationPointCommand}"
                               Margin="0,0,8,8" />
                    <ui:Button Content="{Binding TouchPreviewActionText}" Command="{Binding ToggleTouchCalibrationPreviewCommand}"
                               Margin="0,0,8,8" />
                    <ui:Button Content="{l:T A2854.Cal.Copy}" Command="{Binding CopyTouchCalibrationPointsCommand}"
                               Margin="0,0,0,8" />
                </WrapPanel>
                <TextBlock Text="{Binding TouchDisplayModeText}" Style="{StaticResource A2854Status}"
                           Margin="0,3,0,7" />
                <TextBlock Text="{Binding TouchCalibrationSummary}" Style="{StaticResource A2854Description}" />
                <CheckBox IsChecked="{Binding TouchCalibrationPreviewEnabled, Mode=OneWay}"
                          IsHitTestVisible="False" Focusable="False"
                          Content="{l:T A2854.Cal.PreviewOn}"
                          Margin="0,8,0,2" />
                <TextBlock Text="{l:T A2854.Cal.PreviewInfo}" Style="{StaticResource A2854Secondary}" />
            </StackPanel>
        </Border>

        <TextBlock Text="{l:T Settings.Updates}" Style="{StaticResource Head}" Margin="1,0,0,6" />
        <ui:CardExpander Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,0,0,4">
            <ui:CardExpander.Header>
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock><Run Text="{l:T Settings.Version}" /> <Run Text="{Binding AppVersion, Mode=OneWay}" /></TextBlock>
                        <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding LastChecked}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:HyperlinkButton Content="{l:T Settings.ReleaseNotes}" NavigateUri="{Binding ReleaseUrl}" Padding="0" FontSize="12"
                                            Visibility="{Binding HasReleaseUrl, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <Button Content="{l:T Settings.CheckUpdates}" Command="{Binding CheckUpdatesCommand}" HorizontalAlignment="Right" Margin="0,0,8,0" />
                </Grid>
            </ui:CardExpander.Header>
            <StackPanel>
                <CheckBox IsChecked="{Binding AutoUpdate}">
                    <StackPanel>
                        <TextBlock Text="{l:T Settings.AutoUpdate}" />
                        <TextBlock Text="{l:T Settings.AutoUpdateNote}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </CheckBox>
                <CheckBox IsChecked="{Binding NotifyUpdates}" Content="{l:T Settings.NotifyUpdates}" Margin="0,8,0,0" />
            </StackPanel>
        </ui:CardExpander>

        <TextBlock Text="{l:T Settings.General}" Style="{StaticResource Head}" />
        <ui:CardControl Icon="{ui:SymbolIcon Rocket24}">
            <ui:CardControl.Header><TextBlock Text="{l:T Settings.RunAtStartup}" /></ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding RunAtStartup}" />
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon ArrowMinimize24}">
            <ui:CardControl.Header><TextBlock Text="{l:T Settings.CloseToTray}" /></ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding CloseToTray}" />
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon FolderZip24}">
            <ui:CardControl.Header><TextBlock Text="{l:T Settings.ExportAll}" /></ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:Button Icon="{ui:SymbolIcon FolderZip24}" Content="{l:T Settings.ExportAll}" Command="{Binding ExportAllCommand}" />
                <ui:Button Icon="{ui:SymbolIcon ArrowDownload24}" Content="{l:T Settings.ImportAll}" Command="{Binding ImportAllCommand}" Margin="8,0,0,0" />
            </StackPanel>
        </ui:CardControl>

        <TextBlock Text="{l:T Settings.Language}" Style="{StaticResource Head}" />
        <ui:CardControl Icon="{ui:SymbolIcon LocalLanguage24}">
            <ui:CardControl.Header><TextBlock Text="{l:T Settings.Language}" /></ui:CardControl.Header>
            <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Name" SelectedValuePath="Code"
                      SelectedValue="{Binding Language}" MinWidth="200" />
        </ui:CardControl>

        <TextBlock Text="{l:T Settings.Keyboard}" Style="{StaticResource Head}" />
        <ui:CardControl Icon="{ui:SymbolIcon Keyboard24}">
            <ui:CardControl.Header><TextBlock Text="{l:T Settings.KeyboardCheck}" /></ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding KeyboardEnabled}" />
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon Map24}">
            <ui:CardControl.Header><TextBlock Text="{l:T Settings.Keyboard}" /></ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:Button Icon="{ui:SymbolIcon ArrowReset24}" Content="{l:T Settings.DefaultMap}" Command="{Binding ResetMapCommand}" />
                <ui:Button Icon="{ui:SymbolIcon ArrowExportUp24}" Content="{l:T Settings.ExportMap}" Command="{Binding ExportMapCommand}" Margin="8,0,0,0" />
                <ui:Button Icon="{ui:SymbolIcon ArrowImport24}" Content="{l:T Settings.ImportMap}" Command="{Binding ImportMapCommand}" Margin="8,0,0,0" />
            </StackPanel>
        </ui:CardControl>

        <StackPanel Orientation="Horizontal" Margin="1,14,0,6">
            <TextBlock Text="{l:T Settings.Driver}" Style="{StaticResource Section}" Margin="0" VerticalAlignment="Center" />
            <Button Command="{Binding RefreshDriverCommand}" IsEnabled="{Binding DriverIdle}" ToolTip="{l:T Settings.Refresh}"
                    Cursor="Hand" Padding="6,2" Margin="6,0,0,0" Background="Transparent" BorderThickness="0">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
            </Button>
        </StackPanel>
        <ui:CardControl Icon="{ui:SymbolIcon UsbPlug24}" Visibility="{Binding SeveralAdapters, Converter={StaticResource BoolToVisibility}}">
            <ui:CardControl.Header><TextBlock Text="{l:T Settings.Driver}" /></ui:CardControl.Header>
            <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" IsEnabled="{Binding CanChangeAdapter}" MinWidth="200" />
        </ui:CardControl>
        <TextBlock Text="{Binding DriverText}" TextWrapping="Wrap" Margin="1,0,0,6"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <ui:CardControl Icon="{ui:SymbolIcon UsbStick24}" IsEnabled="{Binding DriverIdle}">
            <ui:CardControl.Header><TextBlock Text="{l:T Settings.Option1}" /></ui:CardControl.Header>
            <Button Content="{Binding WinUsbButton}" IsEnabled="{Binding CanToggleWinUsb}" Command="{Binding ToggleWinUsbCommand}" />
        </ui:CardControl>
        <ui:CardExpander Icon="{ui:SymbolIcon Bluetooth24}" Margin="0,0,0,4" IsEnabled="{Binding DriverIdle}">
            <ui:CardExpander.Header>
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:T Settings.Option2}" />
                        <TextBlock Text="{Binding FilterStatus}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Content="{Binding FilterButton}" IsEnabled="{Binding CanToggleFilter}" Command="{Binding ToggleFilterCommand}" HorizontalAlignment="Right" Margin="0,0,8,0" />
                </Grid>
            </ui:CardExpander.Header>
            <StackPanel>
                <Grid Margin="0,2"><TextBlock Text="{l:T Settings.InstalledVersion}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding FilterInstalled}" HorizontalAlignment="Right" /></Grid>
                <Grid Margin="0,2"><TextBlock Text="{l:T Settings.AvailableVersion}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding FilterAvailable}" HorizontalAlignment="Right" /></Grid>
            </StackPanel>
        </ui:CardExpander>
        <ui:CardExpander Icon="{ui:SymbolIcon Router24}" Margin="0,0,0,4">
            <ui:CardExpander.Header>
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:T Settings.Option3}" />
                        <TextBlock Text="{Binding DongleText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Content="{Binding DongleUpdateText}" Command="{Binding UpdateDongleCommand}" HorizontalAlignment="Right" Margin="0,0,8,0"
                            Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </ui:CardExpander.Header>
            <StackPanel>
                <Grid Margin="0,2"><TextBlock Text="{l:T Settings.InstalledVersion}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding DongleInstalled}" HorizontalAlignment="Right" /></Grid>
                <Grid Margin="0,2"><TextBlock Text="{l:T Settings.AvailableVersion}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding DongleAvailable}" HorizontalAlignment="Right" /></Grid>
            </StackPanel>
        </ui:CardExpander>
        </StackPanel>
        </Grid>
    </Grid>
    </ScrollViewer>

    <!-- Footer banner: build, repository, license -->
    <Border Grid.Row="1" Padding="18,8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
        <WrapPanel HorizontalAlignment="Center" TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
            <TextBlock VerticalAlignment="Center"><Run Text="{l:T Settings.Version}" /> <Run Text="{Binding AppVersion, Mode=OneWay}" /></TextBlock>
            <TextBlock Text="·" Margin="12,0" VerticalAlignment="Center" />
            <ui:HyperlinkButton Content="github.com/Transient-Onlooker/AppleRemoteWin" NavigateUri="https://github.com/Transient-Onlooker/AppleRemoteWin" Padding="0" />
            <TextBlock Text="·" Margin="12,0" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center"><Run Text="{l:T Settings.License}" /> AGPL-3.0-or-later</TextBlock>
            <TextBlock Text="·" Margin="12,0" VerticalAlignment="Center" />
            <ui:HyperlinkButton Content="{l:T Settings.Components}" Command="{Binding ShowComponentsCommand}" Padding="0" />
        </WrapPanel>
    </Border>
    </Grid>
</Page>
