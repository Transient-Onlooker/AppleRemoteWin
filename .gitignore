bin/
obj/
.vs/
*.user
*.suo
publish/

# Python (tools/)
__pycache__/
*.pyc

# Clés d'appairage de la sonde Bumble : secrètes (l'app garde les siennes dans %AppData%\AppleRemote\bonds.json)
tools/siri-remote-keys.json

# Captures personnelles à la racine (tests/AppleRemote.Tests/sample.jsonl reste suivi)
/*.jsonl

# Pilote Rust (src/AppleRemoteDriver) : sortie de compilation et paquet signé
target/
*.sys
*.cat
*.cer
*.pfx
*.pdb

# .NET / IDE / tests
.vscode/
.idea/
*.DotSettings.user
TestResults/
*.log
*.pubxml.user
PublishProfiles/

# Outils locaux
.claude/
graphify-out/

# Rust (src/AppleRemoteDriver)
target/

# Inno Setup
Output/

# Signing keys (the dongle firmware's lives in AppleRemoteWin-Dongle): never commit them
*.pem

# A2854 pairing secrets: protected ciphertext is stored outside the repo in
# LocalApplicationData. Defense in depth if someone copies it into this tree.
**/bond.v1.dpapi
**/bond.v1.dpapi.*.tmp
**/siri-remote-keys.json
**/bonds.json
